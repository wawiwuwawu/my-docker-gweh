# --- PostgreSQL + PostGIS ---
# Kredensial superuser database
POSTGRES_USER=postgis_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=gis_db

# --- GeoServer ---
# Password admin web UI (user: admin). Setelah login pertama, variabel ini
# sebaiknya dikosongkan/dihapus dari .env agar tidak menimpa user yang
# dikelola dari UI (lihat README image resmi GeoServer).
GEOSERVER_ADMIN_PASSWORD=change-me-admin-password

# Bind host untuk web UI/WMS endpoint: default localhost.
# Isi LAN_IP=0.0.0.0 atau IP spesifik bila ingin diakses dari jaringan.
LAN_IP=127.0.0.1

# true = tanpa demo data bawaan (produksi), false = dengan contoh layer
SKIP_DEMO_DATA=false

# JVM memory GeoServer (Tomcat)
EXTRA_JAVA_OPTS=-Xms256m -Xmx1g

# --- Database aplikasi (ERP) — OPSIONAL ---
# Dua user dengan hak terpisah (least-privilege):
#   APP_MIGRATOR_* : owner database, boleh DDL (CREATE/ALTER) — untuk migration
#   APP_WEB_*      : hanya DML (SELECT/INSERT/UPDATE/DELETE) — untuk runtime app
# Biarkan kosong bila tidak dipakai (init ./db-init akan melewatinya).
# Ganti semua nilai di bawah dengan nilai asli Anda di .env — nilai contoh
# ini JANGAN dipakai untuk production.
APP_DB_NAME=
APP_WEB_USER=
APP_WEB_PASSWORD=
APP_MIGRATOR_USER=
APP_MIGRATOR_PASSWORD=
