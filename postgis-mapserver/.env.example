# --- PostgreSQL + PostGIS ---
# Kredensial superuser database
POSTGRES_USER=postgis_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=gis_db

# Port host untuk koneksi DB dari luar (5433 agar tidak bentrok dengan
# postgres-shared di mysql-shared yang memakai 5432)

# --- MapServer ---
# Bind host untuk UI/WMS endpoint: default localhost, isi LAN_IP=0.0.0.0
# atau IP spesifik bila ingin diakses dari jaringan
LAN_IP=127.0.0.1

# Debug MapServer: 0=off, 5=verbose
MS_DEBUGLEVEL=0

# Tuning FastCGI
MAX_PROCESSES=5
MAX_REQUESTS_PER_PROCESS=1000

# Direktori data geospasial di host (shapefile, GeoTIFF, dll.)
# Dipasang read-only ke /mapdata di dalam container — path DATA di
# mapfile contoh merujuk ke /mapdata/namafile
GIS_DATA_DIR=./data

# --- Database aplikasi (ERP) — OPSIONAL ---
# Dua user dengan hak terpisah (least-privilege):
#   APP_MIGRATOR_* : owner database, boleh DDL (CREATE/ALTER) — untuk migration
#   APP_WEB_*      : hanya DML (SELECT/INSERT/UPDATE/DELETE) — untuk runtime app
# Biarkan kosong bila tidak dipakai (init ./db-init akan melewatinya).
# Ganti semua nilai di bawah dengan nilai asli Anda di .env — nilai contoh
# ini JANGAN dipakai untuk production.
APP_DB_NAME=
APP_WEB_USER=
APP_WEB_PASSWORD=
APP_MIGRATOR_USER=
APP_MIGRATOR_PASSWORD=
