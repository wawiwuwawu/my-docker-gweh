# Copy to .env and fill in real values before deploying.
APP_NAME=laravel
APP_ENV=production
APP_KEY=change-me
APP_URL=http://localhost:8080
WEB_PORT=8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# The app container also receives these through env_file: .env
MAIL_PASSWORD=change-me
