# Copy to .env and fill in real values before deploying.
# Generate with: php artisan key:generate --show  (or: openssl rand -base64 32)
APP_KEY=

# Where the app stores its sqlite database (mounted at /data)
DATA_DIR=./data
# Where DB backups are written (mounted at /backups)
BACKUP_DIR=./data/backups
# Public URL of the app
APP_URL=http://localhost:2226
