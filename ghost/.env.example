# Copy to .env and fill in real values before deploying.
# Ghost blog
GHOST_URL=http://localhost:8087

# MySQL (ghost database container)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
database__connection__password=change-me

# S3 image storage (MinIO or compatible)
S3_ACCESS_KEY_ID=ghost-media
storage__s3__secretAccessKey=change-me
S3_ENDPOINT=http://host.docker.internal:9020
S3_ASSET_HOST=http://localhost:9020/ghost-media

# SMTP (Gmail app password or other provider)
MAIL_USER=mail@example.com
mail__options__auth__pass=change-me
MAIL_FROM=Ghost <mail@example.com>
