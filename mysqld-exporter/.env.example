# Copy to .env and fill in real values before deploying.
# Host IP to expose exporter ports on (default: localhost only)
LAN_IP=127.0.0.1
# MySQL connection DSN for postgres-exporter:
# postgresql://user:password@host:5432/dbname?sslmode=disable
DATA_SOURCE_NAME=postgresql://postgres:change-me@host.docker.internal:5432/postgres?sslmode=disable
